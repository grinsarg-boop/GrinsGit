.cod-billing{display:none;margin-top:12px;padding-top:12px;border-top:1px solid #f0f0f0}
.cod-btn{width:100%;padding:14px;background:#ff2e7e;color:#fff;border:none;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;margin-top:12px}
