.cod-prod img{width:56px;height:56px;border-radius:10px;object-fit:cover;border:1px solid #e5e7eb}
.cod-prod-info{flex:1}
.cod-prod-name{font-size:13px;font-weight:600;color:#111827;margin:0 0 2px}
.cod-prod-var{font-size:12px;color:#6b7280;margin:0}
.cod-prod-price{font-size:15px;font-weight:700;color:#111827;white-space:nowrap}
.cod-body{padding:20px}
.cod-lbl{font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;margin:0 0 10px;padding-bottom:6px;border-bottom:1px solid #f3f4f6}
.cod-lbl:not(:first-child){margin-top:20px}
.cod-f{margin-bottom:12px}
.cod-f label{display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:5px}
.cod-f label .req{color:#ef4444}
.cod-f input,.cod-f select,.cod-f textarea{width:100%;padding:11px 14px;border:1.5px solid #d1d5db;border-radius:10px;font-size:14px;color:#111827;outline:none;transition:border-color .2s;box-sizing:border-box}
.cod-f input:focus,.cod-f select:focus,.cod-f textarea:focus{border-color:#97a159}
.cod-f textarea{resize:vertical;min-height:56px}
