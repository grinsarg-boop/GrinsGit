function validatePhone(){
  const raw=$('fPhone').value.trim();const errEl=$('phoneError');const input=$('fPhone');
  if(!raw){input.classList.remove('input-error');errEl.style.display='none';return false;}
  let p=raw.replace(/[\s\-\+\(\)]/g,'');
  if(p.startsWith('54'))p=p.substring(2);if(p.startsWith('9')&&p.length===11)p=p.substring(1);
  if(p.length===10&&p.startsWith('15'))p='11'+p.substring(2);
  const valid=/^\d+$/.test(p)&&p.length>=8&&p.length<=12;
  if(!valid){input.classList.add('input-error');
    if(p.length<8)errEl.textContent='El número es muy corto, verificalo';
    else if(p.length>12)errEl.textContent='El número es muy largo, verificalo';
    else if(!/^\d+$/.test(p))errEl.textContent='Solo podés usar números';
    else errEl.textContent='Número de teléfono inválido';
    errEl.style.display='block';
  }else{input.classList.remove('input-error');errEl.style.display='none';}
  return valid;
}
$('fPhone').addEventListener('blur',validatePhone);
$('fPhone').addEventListener('input',function(){if(this.classList.contains('input-error'))validatePhone();});

/* DNI (7-8 dígitos, sin puntos) */
function validateDni(){
  const input=$('fDni');const errEl=$('dniError');
  if(!input)return false;
  const raw=input.value.trim();
  const clean=raw.replace(/\D/g,'');
  if(clean!==raw)input.value=clean;
  if(!clean){input.classList.remove('input-error');if(errEl)errEl.style.display='none';return false;}
  const valid=/^\d{7,8}$/.test(clean);
  if(!valid){
    input.classList.add('input-error');
    if(errEl){errEl.textContent='El DNI debe tener 7 u 8 dígitos sin puntos';errEl.style.display='block';}
  }else{
    input.classList.remove('input-error');
    if(errEl)errEl.style.display='none';
  }
  return valid;
}
if($('fDni')){
  $('fDni').addEventListener('blur',validateDni);
  $('fDni').addEventListener('input',function(){
    const c=this.value.replace(/\D/g,'');
    if(c!==this.value)this.value=c;
    if(this.classList.contains('input-error'))validateDni();
  });
}

/* Google Places Autocomplete (lazy load on first focus) */
let _gmapsLoading=false, _gmapsReady=false, _autocomplete=null;
window.__codInitAutocomplete=function(){
  _gmapsReady=true;
  try{
    const streetEl=$('fStreet');
    if(!streetEl||!window.google||!window.google.maps||!window.google.maps.places)return;
    _autocomplete=new google.maps.places.Autocomplete(streetEl,{
      componentRestrictions:{country:'ar'},
      fields:['address_components','geometry','formatted_address'],
      types:['address']
    });
    _autocomplete.addListener('place_changed',onPlaceSelected);
  }catch(e){}
};
function loadGmapsLazy(){
  if(_gmapsReady||_gmapsLoading)return;
  if(!GMAPS_KEY){return;}
  _gmapsLoading=true;
  if(window.google&&window.google.maps&&window.google.maps.places){window.__codInitAutocomplete();return;}
  const s=document.createElement('script');
  s.src='https://maps.googleapis.com/maps/api/js?key='+encodeURIComponent(GMAPS_KEY)+'&libraries=places&callback=__codInitAutocomplete&loading=async';
  s.async=true;s.defer=true;
  s.onerror=function(){_gmapsLoading=false;};
  document.head.appendChild(s);
}
function onPlaceSelected(){
  if(!_autocomplete)return;
  let place;
  try{place=_autocomplete.getPlace();}catch(e){return;}
  if(!place||!place.address_components)return;
  const get=(type,short)=>{
    const c=place.address_components.find(x=>x.types&&x.types.indexOf(type)>-1);
    return c?(short?c.short_name:c.long_name):'';
  };
  const route=get('route');
  const streetNum=get('street_number');
  const city=get('locality')||get('sublocality')||get('administrative_area_level_2');
  const prov=get('administrative_area_level_1');
  const cp=get('postal_code');
  if(route)$('fStreet').value=route;
  if(streetNum)$('fNum').value=streetNum;
  if(city)$('fCity').value=city;
  if(prov){
    const provNorm=normalizeProv(prov);
    const sel=$('fProv');
    const found=Array.from(sel.options).find(o=>o.value===provNorm||o.text===provNorm);
    if(found)sel.value=found.value||found.text;
    sel.dispatchEvent(new Event('change'));
  }
  if(cp){
    $('fCP').value=cp;
    $('fCP').dispatchEvent(new Event('input'));
  }
  if(place.geometry&&place.geometry.location){
    try{
      $('fLat').value=place.geometry.location.lat();
      $('fLng').value=place.geometry.location.lng();
    }catch(_){}
  }
  $('fAddrValidated').value='1';
  if($('addrOk'))$('addrOk').classList.add('show');
  if($('addrWarn'))$('addrWarn').classList.remove('show');
}
function normalizeProv(p){
  if(!p)return '';
  const x=p.toLowerCase();
  if(x.indexOf('ciudad aut')>-1||x.indexOf('buenos aires city')>-1||x==='caba')return 'CABA';
  if(x==='provincia de buenos aires'||x==='buenos aires province')return 'Buenos Aires';
  return p.replace(/^provincia de /i,'').replace(/^\w/u,c=>c.toUpperCase());
}
if($('fStreet')){
  $('fStreet').addEventListener('focus',loadGmapsLazy,{once:false});
  $('fStreet').addEventListener('input',function(){
    if($('fAddrValidated').value==='1'){
      $('fAddrValidated').value='0';
      $('fLat').value='';$('fLng').value='';
      if($('addrOk'))$('addrOk').classList.remove('show');
    }
  });
  $('fStreet').addEventListener('blur',function(){
    setTimeout(function(){
      const hasText=$('fStreet').value.trim().length>0;
      const validated=$('fAddrValidated').value==='1';
      if(hasText&&!validated&&GMAPS_KEY){
        if($('addrWarn'))$('addrWarn').classList.add('show');
      }else{
        if($('addrWarn'))$('addrWarn').classList.remove('show');
      }
    },250);
  });
}

let cpTimer;
$('fCP').addEventListener('input',function(){clearTimeout(cpTimer);const cp=this.value.trim();if(cp.length<4){$('dynSection').style.display='none';$('cpStatus').style.display='none';return;}cpTimer=setTimeout(()=>detectCP(cp),400);});

function detectCP(cp){
  /* Se normaliza ANTES de rutear: el CP es el primer bloque de 4 dígitos que no arranca
     en 0, con espacios colapsados ("B1636ABC" → 1636, "18 32" → 1832). Sin esto un CPA
     de AMBA no matchea la tabla FIXY y el pedido se rutea al interior, y un CP basura
     ("S200", "COMUNA 3") viaja crudo al server, que ahora lo rechaza. */
  var cpn=(String(cp).replace(/\s+/g,'').match(/[1-9]\d{3}/)||[])[0];
  if(cpn)cp=cpn;
  S.cp=cp;S.shipCost=0;
  /* Envío gratis siempre. Sólo determinamos AMBA (Fixy efectivo) vs interior (Urbano QR MP). */
  if(FIXY[cp]){S.zone=FIXY[cp];S.amba=true;showStatus('✓','#059669');showShipBadge('🚚 Envío gratis — entrega en 24-72hs hábiles');buildPayOpts(true);}
  else{S.zone='';S.amba=false;showStatus('✓','#2563eb');showShipBadge('🚚 Envío gratis — Andreani/Urbano 48-96hs hábiles');buildPayOpts(false);}
  $('dynSection').style.display='block';updateSum();
}
$('fProv').addEventListener('change',()=>{const cp=$('fCP').value.trim();if(cp.length>=4)detectCP(cp);});
function showStatus(icon,color){const el=$('cpStatus');el.textContent=icon;el.style.color=color;el.style.display='block';}
function showShipBadge(text){$('shipBadge').innerHTML='<div class="cod-ship-badge">'+text+'</div>';}

function buildPayOpts(isAmba){
  let h='';
  /* Efectivo al recibir vía Fixy — SOLO AMBA (Fixy no opera en el interior) */
  if(isAmba){
    h+='<label class="cod-pay" data-p="cod_efectivo"><input type="radio" name="pay" value="cod_efectivo"><div><p class="pay-t">Efectivo — Pagás al recibir <span class="cod-badge bg-g">COD</span></p><p class="pay-d">El cadete cobra en tu puerta en efectivo. Solo CABA y AMBA (Fixy).</p></div></label>';
  }
  /* QR de Mercado Pago al recibir — SIEMPRE. En AMBA lo cobra Fixy; en el interior, Urbano. */
  if(isAmba){
    h+='<label class="cod-pay" data-p="cod_qr_mp"><input type="radio" name="pay" value="cod_qr_mp"><div><p class="pay-t">QR — Pagás al recibir <span class="cod-badge bg-g">COD</span></p><p class="pay-d">Escaneás el QR de Mercado Pago cuando el cadete te entrega. Cualquier billetera o tarjeta en 1 pago. CABA y AMBA (Fixy).</p></div></label>';
  } else {
    h+='<label class="cod-pay" data-p="cod_qr_mp"><input type="radio" name="pay" value="cod_qr_mp"><div><p class="pay-t">QR — Pagás al recibir <span class="cod-badge bg-g">COD</span></p><p class="pay-d">Escaneás el QR de Mercado Pago cuando te llega el pedido. Envío Urbano a todo el país.</p></div></label>';
  }
  /* Mercado Pago — 3 cuotas sin interés (Correo Argentino, link MP) — RECOMENDADO */
  var cuotaVal=Math.round(S.price/3).toLocaleString('es-AR');
  var mpIcon='<img src="https://cdn.shopify.com/s/files/1/0806/1386/7760/files/descarga.png?v=1781542459" alt="Mercado Pago" width="22" height="22" style="flex:0 0 auto;object-fit:contain" loading="lazy">';
  h+='<label class="cod-pay" data-p="cuotas_3"><input type="radio" name="pay" value="cuotas_3"><div><p class="pay-t" style="display:flex;align-items:center;gap:6px">'+mpIcon+'Mercado Pago <span class="cod-badge" style="background:#ff2e7e1f;color:#ff2e7e">🔥 Recomendado</span></p><p class="pay-d">Hasta 3 cuotas sin interés de $'+cuotaVal+'/mes con tarjeta.</p></div></label>';
  $('payOpts').innerHTML=h;
  /* Transferencia APAGADA (2026-07-10). Default: primera opción disponible (COD según zona). */
  $('billingSection').style.display='none';
  var firstOpt=$('payOpts').querySelector('.cod-pay');
  if(firstOpt){
    firstOpt.classList.add('sel');
    var firstInput=firstOpt.querySelector('input');firstInput.checked=true;
    S.payment=firstInput.value;S.carrier=carrierFor(S.payment);
    $('codSubmit').disabled=false;
  }
  $('payOpts').querySelectorAll('.cod-pay').forEach(opt=>{
    opt.addEventListener('click',()=>{
      $('payOpts').querySelectorAll('.cod-pay').forEach(o=>o.classList.remove('sel'));
      opt.classList.add('sel');opt.querySelector('input').checked=true;S.payment=opt.dataset.p;$('codSubmit').disabled=false;
      S.carrier=carrierFor(S.payment);
      updateSum();
    });
  });
}
/* Routing carrier por método de pago.
   cod_qr_mp: en AMBA (zona Fixy) lo cobra Fixy con QR; en el interior lo cobra Urbano.
   (cambio 2026-07-17: Fixy habilitó cobro con QR MercadoPago en la entrega) */
function carrierFor(payment){
  if(payment==='cod_efectivo')return 'fixy';
  if(payment==='cod_qr_mp')return S.amba?'fixy':'urbano';
  return 'andreani'; /* cuotas_3 → Correo Argentino (link MP) */
}
$('diffBilling').addEventListener('change',function(){$('billingFields').style.display=this.checked?'block':'none';});

function updateSum(){
  const sub=S.price;const isCuotas=S.payment==='cuotas_3';
  const total=sub; /* envío gratis siempre; sin descuento prepago (transferencia apagada 2026-07-10) */
  $('sS').textContent=fmt(sub);$('sDiscRow').style.display='none';
  $('sShip').textContent='Gratis';$('sShip').style.color='#059669';$('sTot').textContent=fmt(total);
  var cuotasRow=document.getElementById('sCuotasRow');
  if(!cuotasRow){var sumEl=$('codSum');var div=document.createElement('div');div.className='cod-sum-r';div.id='sCuotasRow';div.innerHTML='<span>3 cuotas de</span><span id="sCuotas" style="color:#7c3aed;font-weight:700"></span>';sumEl.appendChild(div);cuotasRow=div;}
  if(isCuotas){cuotasRow.style.display='flex';document.getElementById('sCuotas').textContent=fmt(Math.round(total/3))+'/mes';}else{cuotasRow.style.display='none';}
}

function waLink(text){return WA?('https://wa.me/'+WA+'?text='+encodeURIComponent(text)):'';}
function setOkWA(text){
  const btn=$('okWA');
  const link=waLink(text);
  if(link){btn.href=link;btn.style.display='inline-flex';}
  else{btn.style.display='none';}
}

/* ═══ SUBMIT — con guard anti-duplicación ═══ */
let _submitting = false;
$('codSubmit').addEventListener('click', async () => {
  if (_submitting) return;
  _submitting = true;

  const name=$('fName').value.trim();
  const phone=(function(p){p=p.replace(/[\s\-\+\(\)]/g,'');if(p.startsWith('54'))p=p.substring(2);if(p.startsWith('9')&&p.length===11)p=p.substring(1);if(p.length===10&&p.startsWith('15'))p='11'+p.substring(2);return p;})($('fPhone').value.trim());
  const email=$('fEmail').value.trim();const street=$('fStreet').value.trim();const num=$('fNum').value.trim();const floor=$('fFloor').value.trim();const prov=$('fProv').value;const city=$('fCity').value.trim();const notes=$('fNotes').value.trim();
  const dni=($('fDni')?$('fDni').value:'').replace(/\D/g,'');
  const addrLat=$('fLat')?$('fLat').value:'';
  const addrLng=$('fLng')?$('fLng').value:'';
  const addrValidated=$('fAddrValidated')&&$('fAddrValidated').value==='1';

  if(!name||!phone||!email||!street||!num||!prov||!city){alert('Completá todos los campos obligatorios.');_submitting=false;return;}
  /* CP: misma regla que el server (bloque de 4 dígitos que no arranca en 0; acepta CPA y
     espacios). El server lo rechaza igual — acá se corta antes para que el comprador lo
     corrija en el momento en vez de perder la venta: pedidos con CP basura ("S200",
     "COMUNA 3") quedaban confirmados e imposibles de despachar. */
  const cpm=String(S.cp||$('fCP').value||'').replace(/\s+/g,'').match(/[1-9]\d{3}/);
  if(!cpm){alert('Revisá el código postal: son 4 números (por ejemplo 1640).');if($('fCP'))$('fCP').focus();_submitting=false;return;}
  S.cp=cpm[0];
  if(!dni||!/^\d{7,8}$/.test(dni)){
    validateDni();
    if($('fDni'))$('fDni').focus();
    $('codSubmit').disabled=false;$('codSpin').style.display='none';_submitting=false;
    return;
  }
  if(phone.length<8||phone.length>12||!/^\d+$/.test(phone)){validatePhone();$('fPhone').focus();$('codSubmit').disabled=false;$('codSpin').style.display='none';_submitting=false;return;}

  $('codSubmit').disabled=true;$('codSpin').style.display='inline-block';

  const isCuotas=S.payment==='cuotas_3';
  const total=S.price; /* envío gratis; sin descuento prepago (transferencia apagada 2026-07-10) */
  const carrier=carrierFor(S.payment);

  const data={
    product_title:S.title,product_handle:S.handle,variant_id:S.variantId,
    quantity:S.qty,price:S.price,
    unit_price:S.unitPrice||S.price,bundle_label:S.bundleLabel||'',
    discount_pct:0,discount_amount:0,
    shipping_cost:0,total:total,
    carrier:carrier,
    payment_method:S.payment,
    cp:S.cp,fixy_zone:S.zone||null,
    customer_name:name,customer_phone:phone,customer_email:email,
    customer_dni:dni,
    address_street:street,address_number:num,address_floor:floor,
    address_province:prov,address_city:city,address_cp:S.cp,
    address_lat:addrLat?parseFloat(addrLat):null,
    address_lng:addrLng?parseFloat(addrLng):null,
    address_validated_google:!!addrValidated,
    billing_address:$('diffBilling')&&$('diffBilling').checked?{address:$('bAddr').value,city:$('bCity').value,province:$('bProv').value}:null,
    notes:notes,accepts_marketing:$('fMkt').checked,
    sku:S.sku||'',source:'cod_checkout_form_biolabs_v1',timestamp:new Date().toISOString()
  };

  /* Pre-abrir ventana ANTES de cualquier await (popup blocker bypass) — solo cuotas_3 */
  var mpWin = null;
  if (isCuotas) {
    mpWin = window.open('about:blank', '_blank');
    if (mpWin && mpWin.document) {
      mpWin.document.write('<title>Redirigiendo a Mercado Pago…</title><style>body{font-family:system-ui,sans-serif;text-align:center;padding:60px 20px;color:#374151}.s{width:42px;height:42px;border:3px solid #e5e7eb;border-top-color:#97a159;border-radius:50%;animation:r 1s linear infinite;margin:0 auto 24px}@keyframes r{to{transform:rotate(360deg)}}</style><div class="s"></div><h2 style="font-weight:600">Generando tu link de pago…</h2><p>Te redirigimos a Mercado Pago en un instante.</p>');
    }
  }

  try{
    var payload=JSON.stringify(data);
    var resp = null;
    var initPoint = null;

    if (isCuotas) {
      /* Cuotas_3: espera respuesta sincrónica del webhook (responseMode=responseNode) para obtener init_point */
      try{
        var r=await fetch(WEBHOOK,{method:'POST',headers:{'Content-Type':'application/json'},body:payload});
        if (r.ok) { resp = await r.json(); if (resp && resp.init_point) initPoint = resp.init_point; }
      }catch(e1){}

      var popupBlocked = (!mpWin || mpWin.closed);

      if (initPoint && !popupBlocked) {
        mpWin.location.href = initPoint;
        let msg='Te abrimos Mercado Pago en una nueva ventana para que termines tu compra en <strong>3 cuotas sin interés de '+fmt(Math.round(total/3))+'</strong>. Si la ventana no se abrió, <a href="'+initPoint+'" target="_blank" rel="noopener" style="color:#97a159;font-weight:700">tocá acá para pagar</a>.';
        $('okMsg').innerHTML=msg;
        setOkWA('Hola! Acabo de hacer un pedido de '+S.title+' por $'+total+' en 3 cuotas. Mi nombre es '+name+', tel: '+phone+'.');
        $('codForm').style.display='none';$('codSuccess').style.display='block';
        if(typeof fbq==='function'){fbq('track','Purchase',{content_name:S.title,content_ids:[S.handle],value:total,currency:'ARS',content_type:'product'});}
      } else if (initPoint && popupBlocked) {
        try {
          var fbPayload = JSON.stringify({
            cliente_telefono: (resp && resp.cliente_telefono) || phone,
            cliente_nombre: (resp && resp.cliente_nombre) || name,
            producto_titulo: (resp && resp.producto_titulo) || S.title,
            cuota_display: (resp && resp.cuota_display) || ('$'+Math.round(total/3).toLocaleString('es-AR')),
            init_point: initPoint,
            preference_id: (resp && resp.preference_id) || null
          });
          fetch(FALLBACK_WA_URL,{method:'POST',headers:{'Content-Type':'application/json'},body:fbPayload,keepalive:true}).catch(function(_){});
        } catch(_) {}
        let msg='No pudimos abrir Mercado Pago automáticamente (tu navegador bloqueó la ventana). <a href="'+initPoint+'" target="_blank" rel="noopener" style="color:#fff;background:#97a159;padding:12px 20px;border-radius:10px;display:inline-block;font-weight:700;text-decoration:none;margin-top:8px">💳 Pagar ahora</a><br><br><small>También te enviamos el link por WhatsApp al <strong>'+phone+'</strong>.</small>';
        $('okMsg').innerHTML=msg;
        setOkWA('Hola! Acabo de hacer un pedido de '+S.title+' por $'+total+' en 3 cuotas. Mi nombre es '+name+', tel: '+phone+'.');
        $('codForm').style.display='none';$('codSuccess').style.display='block';
        if(typeof fbq==='function'){fbq('track','Purchase',{content_name:S.title,content_ids:[S.handle],value:total,currency:'ARS',content_type:'product'});}
      } else {
        if (mpWin && !mpWin.closed) { try{mpWin.close();}catch(_){} }
        try {
          var fbPayload2 = JSON.stringify({
            cliente_telefono: phone,
            cliente_nombre: name,
            producto_titulo: S.title,
            cuota_display: '$'+Math.round(total/3).toLocaleString('es-AR'),
            init_point: '',
            preference_id: null
          });
          fetch(FALLBACK_WA_URL,{method:'POST',headers:{'Content-Type':'application/json'},body:fbPayload2,keepalive:true}).catch(function(_){});
        } catch(_) {}
        $('okMsg').innerHTML='Recibimos tu pedido. Te enviamos el link de pago por WhatsApp al <strong>'+phone+'</strong> en unos minutos. Si no llega, <strong>tocá WhatsApp acá abajo</strong>.';
        setOkWA('Hola! Hice un pedido de '+S.title+' por $'+total+' en 3 cuotas pero no pude generar el link de pago. Mi nombre es '+name+', tel: '+phone+'.');
        $('codForm').style.display='none';$('codSuccess').style.display='block';
      }
    } else {
      /* COD efectivo o QR MP: flujo async (fetch + sendBeacon + XHR fallback) */
      var sent=false;
      try{var r=await fetch(WEBHOOK,{method:'POST',headers:{'Content-Type':'text/plain'},body:payload,keepalive:true});if(r.ok){sent=true;}}catch(e1){}
      if(!sent){try{if(navigator.sendBeacon){sent=navigator.sendBeacon(WEBHOOK,new Blob([payload],{type:'text/plain'}));}}catch(e3){}}
      if(!sent){try{var xhr=new XMLHttpRequest();xhr.open('POST',WEBHOOK,true);xhr.setRequestHeader('Content-Type','text/plain');xhr.send(payload);sent=true;}catch(e4){}}

      if(sent){
        let msg;
        if(S.payment==='cod_qr_mp'){msg='Te contactamos por WhatsApp al <strong>'+phone+'</strong> para confirmar el envío. Pagás <strong>'+fmt(total)+' escaneando el QR de Mercado Pago</strong> al recibir tu pedido.';}
        else{msg='Te contactamos por WhatsApp al <strong>'+phone+'</strong> para confirmar el envío. Pagás <strong>'+fmt(total)+' en efectivo</strong> al recibir.';}
        $('okMsg').innerHTML=msg;
        setOkWA('Hola! Acabo de hacer un pedido de '+S.title+' por $'+total+'. Mi nombre es '+name+', tel: '+phone+', dirección: '+street+' '+num+', '+city+', '+prov+' ('+S.cp+').');
        $('codForm').style.display='none';$('codSuccess').style.display='block';
        if(typeof fbq==='function'){fbq('track','Purchase',{content_name:S.title,content_ids:[S.handle],value:total,currency:'ARS',content_type:'product'});}
      }else{
        var waData='[REGISTRO_PENDIENTE] Producto: '+S.title+' | SKU: '+(S.sku||'')+' | Cant: '+S.qty+' | Total: $'+total+' | Carrier: '+carrier+' | Pago: '+S.payment+' | Nombre: '+name+' | DNI: '+dni+' | Tel: '+phone+' | Email: '+email+' | Dir: '+street+' '+num+(floor?' '+floor:'')+' | Ciudad: '+city+' | Prov: '+prov+' | CP: '+S.cp;
        let fallbackMsg='Te contactamos por WhatsApp al <strong>'+phone+'</strong> para confirmar tu pedido.';
        fallbackMsg+='<br><strong>Tocá el botón de WhatsApp</strong> para enviarnos el comprobante y confirmar tu pedido.';
        $('okMsg').innerHTML=fallbackMsg;setOkWA(waData);$('codForm').style.display='none';$('codSuccess').style.display='block';
      }
    }
  }catch(e){
    if (mpWin && !mpWin.closed) { try{mpWin.close();}catch(_){} }
    alert('Error al enviar pedido:\n\n'+e.message);
    $('codSubmit').disabled=false;$('codSpin').style.display='none';
    _submitting=false;
  }
});

document.addEventListener('click',e=>{
  const btn=e.target.closest('[data-cod-trigger]');if(!btn)return;e.preventDefault();
  const unit=parseFloat(btn.dataset.price)||0;
  const d={title:btn.dataset.title||'',handle:btn.dataset.handle||'',variant:btn.dataset.variant||'',variantId:btn.dataset.variantId||'',price:unit,unitPrice:unit,image:btn.dataset.image||'',qty:parseInt(btn.dataset.qty)||1,sku:btn.dataset.sku||'',bundleLabel:''};
  /* Si Kaching Bundles tiene una oferta seleccionada, reflejar cantidad + precio TOTAL de la oferta.
     Pasamos el precio unitario del variant para poder resolver ofertas en % o monto fijo. */
  const kb=getKachingSelection(unit);
  if(kb){d.qty=kb.quantity;d.price=kb.total;d.bundleLabel=kb.label||('x'+kb.quantity);}
  if(typeof fbq==='function'){fbq('track','InitiateCheckout',{content_name:d.title,content_ids:[d.handle],value:d.price,currency:'ARS'});}
  open(d);
});

/* ── atribución del anuncio → /api/atribucion (16/08/2026) ─────────────────────────────────────
   El pedido no nace acá ni en el checkout de Shopify: lo crea n8n, que lee una lista fija de campos
   del payload. Meter el utm_content adentro de data{} no lo pondría en ningún lado.
   Por eso el ad_id viaja por afuera, y el cruce con el pedido lo hace el panel por teléfono
   (migración 075 · docs/atribucion-utm.md del repo biolabs-finanzas).

   Cuelga del campo de teléfono y NO del submit a propósito: si algo de esto explota, explota en su
   propio handler y la venta sale igual. Es la única razón por la que no está adentro de data{}.

   Probado primero solo en la landing de Altus (16/08/2026, pedido 20031) y abierto a todas ese
   mismo día, con el cruce ya visto en /anuncios. */
var ATRIB_URL = 'https://biolabs-finanzas.vercel.app/api/atribucion';
try {
  var atribAd = null;
  try { atribAd = new URLSearchParams(location.search).get('utm_content'); } catch(e) {}
  /* La compradora puede navegar variantes antes de comprar y ahí la query se pierde. */
  if (atribAd) { try { sessionStorage.setItem('cod_ad_id', atribAd); } catch(e) {} }

  var atribEnviado = '';
  $('fPhone').addEventListener('blur', function() {
    try {
      var ad = atribAd;
      if (!ad) { try { ad = sessionStorage.getItem('cod_ad_id'); } catch(e) {} }
      /* El teléfono va crudo: el cruce usa los últimos 8 dígitos, que sobreviven a cualquier
         normalización de prefijo (+54, el 9, el 15). */
      var ph = this.value.replace(/\D/g, '');
      if (!ad || !/^\d{6,25}$/.test(ad) || ph.length < 8 || ph === atribEnviado) return;
      if (!navigator.sendBeacon) return;
      atribEnviado = ph;
      navigator.sendBeacon(ATRIB_URL, new Blob(
        [JSON.stringify({ phone: ph, ad_id: ad, handle: S.handle })], { type: 'text/plain' }));
    } catch(e) {}
  });
} catch(e) {}
})();
</script>

