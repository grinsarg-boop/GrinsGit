      </div>
      <button class="cod-btn" id="codSubmit" disabled>
        <span class="spin" id="codSpin"></span>
        Realizar pedido
      </button>
    </div>
  </div>
  <div class="cod-ok" id="codSuccess">
    <div class="chk">✓</div>
    <h3>¡Pedido recibido!</h3>
    <p id="okMsg"></p>
    <a class="wa" id="okWA" href="#" target="_blank">💬 Contactanos por WhatsApp</a>
  </div>
</div>
</div>

