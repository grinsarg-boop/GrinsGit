/* ─── Kaching Bundles: lee la oferta seleccionada (cantidad + precio total) ───
   Las definiciones (dealBars con quantity, discountType y discountValue) vienen server-rendered en
   <script class="kaching-bundles-deal-block-settings">. El bar elegido en el DOM lleva
   data-deal-bar-id + la clase .kaching-bundles__bar--selected. Mapeamos id→oferta.

   IMPORTANTE: discountValue NO siempre es el precio total del pack. Depende de discountType:
     · 'specific'/'fixed_price'  → discountValue ES el total del pack (ej. 45000).
     · 'percentage'             → discountValue es un % OFF sobre el precio regular (unit*qty).
                                  ej. un 2x1 configurado como percentage 50 → 45000*2*(1-.5)=45000.
     · 'amount'/'fixed_amount'  → discountValue es un monto fijo a descontar del precio regular.
   Si tomáramos discountValue directo como total (bug histórico), una oferta en % mostraría "$50".
   Por eso computamos el total real con computeBundleTotal(), usando el precio unitario del variant.
   Degradación: si no hay Kaching o no se puede leer, devuelve null y se usa el precio unitario. */
function computeBundleTotal(deal,unitPrice,qty){
  var v=Number(deal.value)||0;
  var regular=(Number(unitPrice)||0)*qty;
  var type=String(deal.type||'').toLowerCase();
  if(type==='percentage'||type==='percent'){
    if(regular>0)return Math.round(regular*(1-v/100));
    return 0;
  }
  if(type==='amount'||type==='fixed_amount'||type==='fixed'){
    if(regular>0)return Math.max(0,Math.round(regular-v));
    return 0;
  }
  /* 'specific'/'fixed_price'/'price' y cualquier otro: discountValue = total fijo del pack */
  return Math.round(v);
}
function getKachingSelection(unitPrice){
  try{
    var cfgEl=document.querySelector('script.kaching-bundles-deal-block-settings');
    if(!cfgEl)return null;
    var cfg=JSON.parse(cfgEl.textContent||'{}');
    var bars=cfg.dealBars||[];
    if(!bars.length)return null;
    var byId={};bars.forEach(function(b){byId[b.id]={qty:b.quantity||1,type:b.discountType,value:b.discountValue,title:b.title||''};});
    var selId=null;
    /* 1) bar marcado como seleccionado en el DOM */
    var selEl=document.querySelector('.kaching-bundles__bar--selected, .kaching-bundles__bar[selected]');
    if(selEl){
      var host=selEl.matches('[data-deal-bar-id]')?selEl:(selEl.closest('[data-deal-bar-id]')||selEl.querySelector('[data-deal-bar-id]'));
      if(host)selId=host.getAttribute('data-deal-bar-id');
    }
    /* 2) fallback: radio chequeado dentro de un bar */
    if(!selId){
      var checked=document.querySelector('.kaching-bundles__bar-radio:checked, .kaching-bundles__bar input[type=radio]:checked');
      if(checked){var h2=checked.closest('[data-deal-bar-id]');if(h2)selId=h2.getAttribute('data-deal-bar-id');}
    }
    /* 3) fallback: preseleccionado de la config */
    if(!selId)selId=cfg.preselectedDealBarId;
    var deal=selId&&byId[selId];
    if(!deal)return null;
    var qty=deal.qty||1;
    var total=computeBundleTotal(deal,unitPrice,qty);
    if(!(total>0))return null;
    return {quantity:qty,total:total,label:deal.title};
  }catch(e){return null;}
}

