# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # solo server-side, jamás en el cliente

# ---- Auth ----
ALLOWED_EMAILS=vos@..., socio@...   # whitelist, separados por coma

# ---- Scheduler ----
CRON_SECRET=                        # Bearer para /api/sync/* (lo usan n8n o Vercel Cron)

# ---- Shopify (client credentials grant: el token de 24 h se pide y cachea solo) ----
SHOPIFY_SHOP_DOMAIN=biolabs.myshopify.com
SHOPIFY_CLIENT_ID=                  # de la app (read_orders, read_fulfillments)
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=             # para verificar HMAC

# ---- Meta ----
META_API_VERSION=v25.0
META_AD_ACCOUNT_ID=act_880189106877616
META_ACCESS_TOKEN=                  # system user con ads_read sobre la cuenta

# ---- Urbano (API oficial) ----
# apis.urbano.com.ar es la plataforma OPERATIVA. Política (actualizada 22/07):
#   · SYNC automático: SOLO tracking (POST /tracking/consultaTrackingMasivo/) — read-only, nunca dispara operaciones.
#   · Acciones OPERATIVAS (wbs/rescate redireccionamiento/devolución, cargaCliente) PERMITIDAS desde flujos
#     explícitos: server-side, confirmadas, logueadas e idempotentes — nunca desde el sync ni el browser.
#   · Cancelación (servicio-cancelacion-rescate) se depreca 07/2026 → no construir sobre ese endpoint sin reemplazo de Urbano.
URBANO_API_URL=https://apis.urbano.com.ar/   # con barra final
URBANO_SHIPPER=4362
URBANO_PASSWORD=                             # shipper+password sirve para tracking Y para wbs/rescate (redireccionamiento/devolución)

# ---- Fixy (API oficial de tracking) ----
FIXY_API_URL=https://fixy.epresis.com/       # tracking read-only: POST /api/v2/seguimiento.json
FIXY_SUCURSAL=1764855883
FIXY_SERVICIO=2
FIXY_API_TOKEN=

# ---- MercadoLibre ----
# Modo actual: token de producción ESTÁTICO del panel (Credenciales de producción → Access Token).
ML_CLIENT_ID=                       # App ID de developers.mercadolibre.com.ar (numérico)
ML_CLIENT_SECRET=                   # "Clave secreta": string plano ~32 chars, SIN prefijo APP_USR-
ML_SELLER_ID=262382468              # seller de la cuenta (Remitente de las etiquetas ML)
ML_ACCESS_TOKEN=                    # Access Token de producción (APP_USR-...); lo usa el conector directo
ML_REFRESH_TOKEN=                   # opcional: si algún día se hace OAuth (TG-...), activa refresh+rotación

# ---- Twilio (Fase 3, alertas WhatsApp) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_FROM=whatsapp:+14155238886
ALERT_WA_TO=whatsapp:+549...

# ---- Asistente in-app (chat /api/chat) ----
# Misma cuenta Anthropic que el bot de WhatsApp (app-gastos): la key NO es por-proyecto, reusá la misma.
ANTHROPIC_API_KEY=                   # sk-ant-... (server-side; jamás en el cliente)
CHAT_MODEL=                          # opcional; default claude-opus-4-8. Más barato / igual que el bot: claude-sonnet-5
