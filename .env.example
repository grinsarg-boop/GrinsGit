# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # solo server-side, jamás en el cliente

# ---- Auth ----
ALLOWED_EMAILS=vos@..., socio@...   # whitelist, separados por coma

# ---- Scheduler ----
CRON_SECRET=                        # Bearer para /api/sync/* (lo usan n8n o Vercel Cron)

# ---- Shopify ----
SHOPIFY_SHOP_DOMAIN=biolabs.myshopify.com
SHOPIFY_ADMIN_TOKEN=                # Admin API access token (read_orders, read_fulfillments)
SHOPIFY_WEBHOOK_SECRET=             # para verificar HMAC

# ---- Meta ----
META_API_VERSION=v25.0
META_AD_ACCOUNT_ID=act_880189106877616
META_ACCESS_TOKEN=                  # system user con ads_read sobre la cuenta

# ---- Urbano (webservice de tracking) ----
URBANO_WS_URL=
URBANO_WS_USER=
URBANO_WS_PASS=

# ---- Fixy (pendiente doc de API — SPEC §10) ----
FIXY_API_URL=
FIXY_API_TOKEN=

# ---- Twilio (Fase 3, alertas WhatsApp) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_FROM=whatsapp:+14155238886
ALERT_WA_TO=whatsapp:+549...
