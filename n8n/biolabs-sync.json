{
  "name": "BioLabs — Sync COD",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "minutes", "minutesInterval": 5 } ] }
      },
      "id": "sched-urbano",
      "name": "Urbano cada 5min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://biolabs-finanzas.vercel.app/api/sync/urbano?limit=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer PEGA_ACA_EL_CRON_SECRET" }
          ]
        },
        "options": { "timeout": 60000 }
      },
      "id": "http-urbano",
      "name": "Sync Urbano (100 stalest)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "rule": { "interval": [ { "field": "hours", "hoursInterval": 1 } ] }
      },
      "id": "sched-meta",
      "name": "Meta cada 1h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://biolabs-finanzas.vercel.app/api/sync/meta",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer PEGA_ACA_EL_CRON_SECRET" }
          ]
        },
        "options": { "timeout": 60000 }
      },
      "id": "http-meta",
      "name": "Sync Meta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 200]
    }
  ],
  "connections": {
    "Urbano cada 5min": { "main": [ [ { "node": "Sync Urbano (100 stalest)", "type": "main", "index": 0 } ] ] },
    "Meta cada 1h": { "main": [ [ { "node": "Sync Meta", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" }
}
