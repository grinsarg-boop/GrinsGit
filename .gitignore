# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# datos reales (no versionar)
datos/

# skills de terceros: se reproducen desde skills-lock.json, no se versionan
/.agents/
/.claude/skills/*
!/.claude/skills/creativos-meta/
!/.claude/skills/qa-ojo-de-cliente/
/.claude/launch.json

# estado de corridas de redespacho (guías y pedidos reales, como datos/)
/.redespacho-*.json

# propuesta nocturna de despacho (números de pedido reales, como los .redespacho-*)
/.despacho-propuesta.json

# guías reales de pedidos reales (como los .redespacho-*)
/.despacho-guias-huerfanas.csv

# hora en que se generó cada etiqueta (números de pedido reales)
/.despacho-etiquetas.json

# PDFs y CSVs de etiquetas: nombre, dirección y teléfono de clientes reales
/etiquetas/
